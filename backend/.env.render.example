# Copy these keys into Render → Environment (do NOT import local .env as-is)

NODE_ENV=production

# Atlas: replace YOUR_PASSWORD with Database Access password (URL-encode @ # % etc.)
MONGODB_URI=mongodb+srv://jobboard_user:YOUR_PASSWORD@cluster0.dkjyqat.mongodb.net/ai_job_board?retryWrites=true&w=majority

JWT_SECRET=generate_a_long_random_string
SESSION_SECRET=generate_another_long_random_string

CLIENT_URL=https://job-board-seven-sigma.vercel.app
SERVER_URL=https://jobboard-sd2e.onrender.com

GOOGLE_CALLBACK_URL=https://jobboard-sd2e.onrender.com/api/auth/google/callback
GITHUB_CALLBACK_URL=https://jobboard-sd2e.onrender.com/api/auth/github/callback
LINKEDIN_CALLBACK_URL=https://jobboard-sd2e.onrender.com/api/auth/linkedin/callback

# OAuth IDs/secrets only if you have them configured
# GOOGLE_CLIENT_ID=
